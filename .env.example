# Copy to .env (never commit .env). All values are optional; the app runs in demo mode without any.

# Free NASA FIRMS MAP_KEY (32 lowercase alphanumerics) from https://firms.modaps.eosdis.nasa.gov/api/map_key/
# Not needed for the demo snapshot or the public 24h/48h/7d global feeds used by "Live NRT".
FIRMS_MAP_KEY=

# "demo" (bundled snapshot only) or "live" (also download public FIRMS NRT feeds at startup)
TW_DEFAULT_DATASET=demo
TW_LIVE_FEED_WINDOW=7d
TW_LIVE_CACHE_MINUTES=30

# Comma-separated JSON list of allowed browser origins for direct API access
TW_CORS_ORIGINS=["http://localhost:3000"]

# Frontend -> backend proxy target (read by next.config.ts)
TERRAWATCH_API_URL=http://127.0.0.1:8000
